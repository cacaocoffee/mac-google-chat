{
  "manifest_version": 3,
  "name": "ChatLamp",
  "version": "0.1.0",
  "description": "Google Chat에 안 읽은 메시지가 있으면 맥 메뉴 막대의 ChatLamp 아이콘에 불을 켭니다.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ChatLamp",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["nativeMessaging", "storage", "scripting"],
  "host_permissions": ["https://chat.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chat.google.com/*"],
      "js": ["content/badge-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://chat.google.com/*"],
      "js": ["content/detect.js", "content/watch.js"],
      "run_at": "document_start"
    }
  ]
}
